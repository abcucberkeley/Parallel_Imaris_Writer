# Every program and library of this project brings its own C++ runtime, LZ4 and zlib, and takes none of them
# from libcppTiff or libcppZarr; and the two reader libraries, as this project builds them, export none of
# theirs (CMakeLists.txt: piw_reader_exports, piw_link_like_executable).
#
# Across copies of the C++ runtime, symbols bound to another library's copy mix two runtimes' state in one
# program: on macOS iostreams, locales and std::filesystem copies aborted silently that way. And the LZ4 that
# compresses every chunk of an .ims is the pinned one only if the program does not take another library's.
#
#   cmake -DPLATFORM=<Linux|Darwin|Windows> -DNM=<nm> -DOBJDUMP=<objdump>
#         -DREADERS=<libcppTiff>|<libcppZarr> -DBINARIES=<file>|<file>... -P runtime_isolation.cmake
#
# READERS: the two reader libraries; BINARIES: our programs and libraries. For each, what it binds to the
# readers (Linux: what it leaves undefined at all), and the exports of the libraries. The checks per system:
#   Linux    nm -D: a binary leaves no C++ runtime, LZ4 or zlib symbol undefined (glibc's own __cxa_atexit
#            and the like excepted; the unwinder is the system's libgcc_s, shared by everything in a
#            process) and needs no libstdc++.so; a library exports none of them, nor the unwinder's or
#            nlohmann/json's.
#   macOS    nm -m: no binary binds a C++ runtime, unwinder, LZ4, zlib or nlohmann/json symbol to a reader,
#            or anything to a shared libstdc++; the libraries export none of them.
#   Windows  objdump -p: no binary imports one from a reader DLL, or anything from libstdc++-6.dll; the
#            libraries export no unwinder, LZ4, zlib or C++ ABI (__cxa_*, __gxx_*) function. (MinGW exports
#            every global symbol of a DLL's own objects, the template instantiations of namespace std among
#            them: those are counted, not refused.)
# Lists use "|" as separators (a ";" would split the ctest argument).

foreach(v PLATFORM NM OBJDUMP READERS BINARIES)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "runtime_isolation.cmake: -D${v}=... is missing")
    endif()
endforeach()
string(REPLACE "|" ";" READERS "${READERS}")
string(REPLACE "|" ";" BINARIES "${BINARIES}")

# Mangled names (the extra leading underscore of Mach-O names already removed). An entity of namespace std
# (std::x, std::x::y, typeinfo/vtable/VTT/guard variable/local static/thunk of one; St, or Sa Sb Ss Si So Sd,
# the abbreviations of allocator, basic_string, string, istream, ostream, iostream), of __gnu_cxx or of
# __cxxabiv1; operator new and delete; the C++ ABI's C functions.
set(SPECIAL "^_Z(T[VTISHW]|TC|Th[n0-9_]*|Tv[n0-9_]*|GV|GR|Z)*N?[rVKRO]*")
set(RE_CXX "${SPECIAL}(St|S[absiod]|9__gnu_cxx|10__cxxabiv1)|^_Z(nw|na|dl|da)|^__cxa_|^__gxx_|^__dynamic_cast$")
set(RE_NLOHMANN "${SPECIAL}8nlohmann")
set(RE_UNWIND "^_Unwind_")
set(RE_LZ4 "^LZ4")
set(RE_ZLIB "^(adler32|compress|crc32|deflate|inflate|uncompress|zlibVersion|zlibCompileFlags|zError|get_crc_table|z_errmsg|zcalloc|zcfree|_tr_|gz(open|dopen|close|read|write|printf|puts|gets|putc|getc|flush|seek|tell|eof|error|buffer|setparams|rewind|offset|direct|ungetc|clearerr|fread|fwrite|vprintf))")
set(CATEGORIES CXX UNWIND LZ4 ZLIB NLOHMANN)
set(LABEL_CXX "C++ runtime")
set(LABEL_UNWIND "unwinder")
set(LABEL_LZ4 "LZ4")
set(LABEL_ZLIB "zlib")
set(LABEL_NLOHMANN "nlohmann/json")

set(gFailed FALSE)

# Runs a tool and returns its output lines in <out>.
function(run_tool out)
    execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE text ERROR_VARIABLE err RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "failed (${rc}): ${ARGN}\n${err}")
    endif()
    string(REPLACE ";" "\\;" text "${text}")
    string(REPLACE "\n" ";" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Counts <names> per category: <prefix>_<CAT> (count) and <prefix>_<CAT>_NAMES (the first few), <prefix>_ALL.
function(classify prefix names)
    list(LENGTH names n)
    set(${prefix}_ALL ${n} PARENT_SCOPE)
    foreach(cat ${CATEGORIES})
        set(count 0)
        set(found "")
        foreach(name IN LISTS names)
            if(name MATCHES "${RE_${cat}}")
                math(EXPR count "${count} + 1")
                if(count LESS_EQUAL 8)
                    list(APPEND found "${name}")
                endif()
            endif()
        endforeach()
        set(${prefix}_${cat} ${count} PARENT_SCOPE)
        set(${prefix}_${cat}_NAMES "${found}" PARENT_SCOPE)
    endforeach()
endfunction()

# "<n> (C++ runtime <n>, unwinder <n>, ...)" for the categories given.
function(describe out prefix)
    set(parts "")
    foreach(cat ${ARGN})
        list(APPEND parts "${LABEL_${cat}} ${${prefix}_${cat}}")
    endforeach()
    string(REPLACE ";" ", " parts "${parts}")
    set(${out} "${${prefix}_ALL} (${parts})" PARENT_SCOPE)
endfunction()

# Fails (at the end) when any category of <refused> has a symbol.
function(refuse file what prefix)
    foreach(cat ${ARGN})
        if(${prefix}_${cat} GREATER 0)
            string(REPLACE ";" " " names "${${prefix}_${cat}_NAMES}")
            message("  FAIL ${file}: ${what} ${${prefix}_${cat}} ${LABEL_${cat}} symbols, e.g. ${names}")
            set(gFailed TRUE PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# The defined, exported symbols of a library.
function(exports_of out file)
    set(names "")
    if(PLATFORM STREQUAL "Darwin")
        run_tool(lines "${NM}" -m "${file}")
        foreach(l IN LISTS lines)
            if(l MATCHES "^[0-9a-f]+ \\([^)]*\\) (weak )?external _([^ ]+)")
                list(APPEND names "${CMAKE_MATCH_2}")
            endif()
        endforeach()
    elseif(PLATFORM STREQUAL "Windows")
        run_tool(lines "${OBJDUMP}" -p "${file}")
        set(inExports FALSE)
        foreach(l IN LISTS lines)
            if(l MATCHES "^\\[Ordinal/Name Pointer\\] Table")
                set(inExports TRUE)
            elseif(l MATCHES "^(The |PE File)")
                set(inExports FALSE)
            elseif(inExports AND l MATCHES "^[ \t]+\\[ *[0-9]+\\].* ([^ \t]+)$")
                list(APPEND names "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    else()
        run_tool(lines "${NM}" -D --defined-only "${file}")
        foreach(l IN LISTS lines)
            if(l MATCHES "^[0-9a-fA-F]* *[A-Za-z] ([^ @]+)")
                list(APPEND names "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endif()
    set(${out} "${names}" PARENT_SCOPE)
endfunction()

function(check_exports file)
    get_filename_component(name "${file}" NAME)
    exports_of(names "${file}")
    classify(E "${names}")
    describe(text E ${CATEGORIES})
    message("  ${name}: exports ${text}")
    # (every library checked exports its API: none found means the tool's output was not understood)
    if(E_ALL EQUAL 0)
        message("  FAIL ${name}: no export found in the output of ${NM} / ${OBJDUMP}")
        set(gFailed TRUE)
    endif()
    if(PLATFORM STREQUAL "Windows")
        # (the C++ runtime's own functions, not the template instantiations of the DLL's own objects)
        set(cabi "")
        foreach(n IN LISTS names)
            if(n MATCHES "^(__cxa_|__gxx_|__dynamic_cast$|_Z(nw|na|dl|da))")
                list(APPEND cabi "${n}")
            endif()
        endforeach()
        list(LENGTH cabi E_CABI)
        set(E_CABI_NAMES "${cabi}")
        set(LABEL_CABI "C++ ABI")
        refuse("${name}" "exports" E CABI UNWIND LZ4 ZLIB)
    else()
        refuse("${name}" "exports" E ${CATEGORIES})
    endif()
    set(gFailed ${gFailed} PARENT_SCOPE)
endfunction()

# What a binary binds to the readers (macOS, Windows) or leaves undefined (Linux); and a library's exports
# (check_binary(<file> library), or a file named lib*.so, lib*.dylib or lib*.dll).
function(check_binary file)
    get_filename_component(name "${file}" NAME)
    # (imported symbols of any library: every program and library has some, from the C library at
    # least, so none found means the tool's output was not understood)
    set(imported 0)
    if(PLATFORM STREQUAL "Darwin")
        run_tool(lines "${NM}" -m "${file}")
        set(fromReaders "")
        set(fromStdcxx 0)
        foreach(l IN LISTS lines)
            if(l MATCHES "\\(undefined\\) (weak )?external _([^ ]+) \\(from ([^)]+)\\)")
                set(sym "${CMAKE_MATCH_2}")
                set(from "${CMAKE_MATCH_3}")
                math(EXPR imported "${imported} + 1")
                if(from MATCHES "^libcpp(Tiff|Zarr)")
                    list(APPEND fromReaders "${sym}")
                elseif(from MATCHES "^libstdc\\+\\+")
                    math(EXPR fromStdcxx "${fromStdcxx} + 1")
                endif()
            endif()
        endforeach()
        classify(B "${fromReaders}")
        describe(text B ${CATEGORIES})
        message("  ${name}: bound to libcppTiff/libcppZarr ${text}; to libstdc++ ${fromStdcxx}")
        refuse("${name}" "binds to the readers" B ${CATEGORIES})
        if(fromStdcxx GREATER 0)
            message("  FAIL ${name}: binds ${fromStdcxx} symbols to a shared libstdc++ (it links its own, statically)")
            set(gFailed TRUE)
        endif()
    elseif(PLATFORM STREQUAL "Windows")
        run_tool(lines "${OBJDUMP}" -p "${file}")
        set(fromReaders "")
        set(stdcxxDll FALSE)
        set(inImports FALSE)
        set(dll "")
        foreach(l IN LISTS lines)
            if(l MATCHES "^The Import Tables")
                set(inImports TRUE)
            elseif(l MATCHES "^(The |PE File)")
                set(inImports FALSE)
            elseif(l MATCHES "^[ \t]*$")
                set(dll "")
            elseif(inImports AND l MATCHES "DLL Name: *([^ \t]+)")
                set(dll "${CMAKE_MATCH_1}")
                if(dll MATCHES "^libstdc\\+\\+")
                    set(stdcxxDll TRUE)
                endif()
            # A function imported by name: "<vma> <hint> <name>" (older binutils) or
            # "<vma> <none> <hint> <name>" (newer ones print an ordinal column first)
            elseif(inImports AND NOT dll STREQUAL "" AND
                   l MATCHES "^\t[0-9a-fA-F]+[ \t]+(<none>[ \t]+)?[0-9a-fA-F]+[ \t]+([^ \t<][^ \t]*)")
                set(sym "${CMAKE_MATCH_2}")
                math(EXPR imported "${imported} + 1")
                if(dll MATCHES "^libcpp(Tiff|Zarr)")
                    list(APPEND fromReaders "${sym}")
                endif()
            endif()
        endforeach()
        classify(B "${fromReaders}")
        describe(text B ${CATEGORIES})
        message("  ${name}: imported from libcppTiff/libcppZarr ${text}; libstdc++ DLL imported: ${stdcxxDll}")
        refuse("${name}" "imports from the readers" B ${CATEGORIES})
        if(stdcxxDll)
            message("  FAIL ${name}: imports a libstdc++ DLL (it links its own C++ runtime, statically)")
            set(gFailed TRUE)
        endif()
    else()
        run_tool(lines "${NM}" -D --undefined-only "${file}")
        set(undefined "")
        foreach(l IN LISTS lines)
            # (glibc's own __cxa_atexit, __cxa_finalize and __cxa_thread_atexit_impl are not the C++ runtime's)
            if(l MATCHES "^ *[A-Za-z] ([^ @]+)")
                set(sym "${CMAKE_MATCH_1}")
                math(EXPR imported "${imported} + 1")
                if(NOT sym MATCHES "^__cxa_(atexit|finalize|thread_atexit_impl)$")
                    list(APPEND undefined "${sym}")
                endif()
            endif()
        endforeach()
        run_tool(dyn "${OBJDUMP}" -p "${file}")
        set(stdcxx FALSE)
        foreach(l IN LISTS dyn)
            if(l MATCHES "NEEDED +libstdc\\+\\+")
                set(stdcxx TRUE)
            endif()
        endforeach()
        classify(B "${undefined}")
        describe(text B CXX LZ4 ZLIB NLOHMANN)
        message("  ${name}: undefined (not glibc's) ${text}; needs libstdc++.so: ${stdcxx}")
        refuse("${name}" "leaves undefined" B CXX LZ4 ZLIB NLOHMANN)
        if(stdcxx)
            message("  FAIL ${name}: needs a shared libstdc++ (it links its own, statically)")
            set(gFailed TRUE)
        endif()
    endif()
    if(imported EQUAL 0)
        message("  FAIL ${name}: no imported symbol found in the output of ${NM} / ${OBJDUMP}")
        set(gFailed TRUE)
    endif()
    # The exports of the readers, and of our own libraries (the Python package's: lib*.so and the like)
    if(ARGV1 STREQUAL "library" OR name MATCHES "^lib.*\\.(so|dylib|dll)(\\.[0-9.]+)?$")
        check_exports("${file}")
    endif()
    set(gFailed ${gFailed} PARENT_SCOPE)
endfunction()

message("Reader libraries:")
foreach(f IN LISTS READERS)
    if(NOT f STREQUAL "")
        check_binary("${f}" library)
    endif()
endforeach()
message("Our programs and libraries:")
foreach(f IN LISTS BINARIES)
    if(NOT f STREQUAL "")
        check_binary("${f}")
    endif()
endforeach()
if(gFailed)
    message(FATAL_ERROR "runtime isolation: FAILED")
endif()
message("runtime isolation: PASSED")
