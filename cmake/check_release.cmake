# Checks the release folder as cmake/stage_release.cmake assembled it (the releaseFolder test):
#   * it holds exactly the expected files, flat;
#   * no file contains an absolute path of the build: the source, build and dependency folders and the
#     compilers (as given and with links resolved; on Windows with either slash and in any case);
#   * Linux: the executable and libraries have the RPATH $ORIGIN and nothing else, the OpenMP runtime none
#     or $ORIGIN; macOS: their LC_RPATH is @loader_path alone (the runtime's none or that), and they load
#     nothing by an absolute path but the system's (/usr/lib, /System);
#   * the OpenMP runtime is a binary (ELF or Mach-O), not a linker script;
#   * STRIPPED: no debug information (Linux, Windows) and no static symbol table (Linux).
#
#   cmake -DPLATFORM=<Linux|Darwin|Windows> -DRELEASE_DIR=<dir> -DEXPECTED=<name>|<name>...
#         -DFORBIDDEN=<dir>|<dir>... [-DOPENMP_RUNTIME=<name>] [-DOBJDUMP=<objdump>] [-DSTRIPPED=ON|OFF]
#         -P check_release.cmake
# Lists use "|" as separators.

cmake_minimum_required(VERSION 3.18)

foreach(v PLATFORM RELEASE_DIR EXPECTED FORBIDDEN)
    if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
        message(FATAL_ERROR "check_release.cmake: -D${v}=... is missing")
    endif()
endforeach()
string(REPLACE "|" ";" EXPECTED "${EXPECTED}")
string(REPLACE "|" ";" FORBIDDEN "${FORBIDDEN}")

set(gFailed FALSE)
macro(fail text)
    message("  FAIL ${text}")
    set(gFailed TRUE)
endmacro()

function(tool_output out)
    execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE text ERROR_VARIABLE err RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "failed (${rc}): ${ARGN}\n${err}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The folder's contents
file(GLOB present RELATIVE "${RELEASE_DIR}" "${RELEASE_DIR}/*")
list(SORT present)
set(want ${EXPECTED})
list(SORT want)
message("Release folder ${RELEASE_DIR}: ${present}")
if(NOT present STREQUAL want)
    fail("the folder holds [${present}], expected [${want}]")
endif()

# The paths no file may contain, as a regular expression
set(paths "")
foreach(p IN LISTS FORBIDDEN)
    if(p STREQUAL "")
        continue()
    endif()
    get_filename_component(real "${p}" REALPATH)
    list(APPEND paths "${p}" "${real}")
    if(PLATFORM STREQUAL "Windows")
        file(TO_NATIVE_PATH "${p}" native)
        file(TO_NATIVE_PATH "${real}" nativeReal)
        list(APPEND paths "${native}" "${nativeReal}")
    endif()
endforeach()
list(REMOVE_DUPLICATES paths)
set(alternatives "")
foreach(p IN LISTS paths)
    string(REGEX REPLACE "/+$" "" p "${p}")
    string(REGEX REPLACE "([][.*+?^$()|\\\\])" "\\\\\\1" re "${p}")
    if(PLATFORM STREQUAL "Windows")
        # (any case: drive letters and folder names are case-insensitive there). By index, not as a
        # list of characters: a lone backslash in a CMake list escapes the separator after it.
        string(LENGTH "${re}" n)
        set(ci "")
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE 0 ${last})
                string(SUBSTRING "${re}" ${i} 1 c)
                string(TOLOWER "${c}" lo)
                string(TOUPPER "${c}" up)
                if(lo STREQUAL up)
                    string(APPEND ci "${c}")
                else()
                    string(APPEND ci "[${lo}${up}]")
                endif()
            endforeach()
        endif()
        set(re "${ci}")
    endif()
    list(APPEND alternatives "${re}")
endforeach()
string(REPLACE ";" "|" pathRegex "${alternatives}")
message("Paths refused: ${paths}")

foreach(name IN LISTS present)
    set(file "${RELEASE_DIR}/${name}")
    if(IS_DIRECTORY "${file}")
        continue()
    endif()
    file(SIZE "${file}" size)
    file(STRINGS "${file}" hits REGEX "${pathRegex}" NO_HEX_CONVERSION)
    list(LENGTH hits nHits)
    message("  ${name}: ${size} bytes, ${nHits} strings with a build path")
    if(nHits GREATER 0)
        list(SUBLIST hits 0 5 some)
        string(REPLACE ";" "\n      " some "${some}")
        fail("${name} contains a build path, e.g.\n      ${some}")
    endif()
endforeach()

# RPATH and dependencies
foreach(name IN LISTS present)
    set(file "${RELEASE_DIR}/${name}")
    set(isRuntime FALSE)
    if(DEFINED OPENMP_RUNTIME AND name STREQUAL OPENMP_RUNTIME)
        set(isRuntime TRUE)
    endif()
    if(PLATFORM STREQUAL "Linux")
        tool_output(dyn "${OBJDUMP}" -p "${file}")
        string(REGEX MATCHALL "\n *(RPATH|RUNPATH) +[^\n]*" entries "${dyn}")
        set(rpaths "")
        foreach(e IN LISTS entries)
            string(REGEX REPLACE "^\n *(RPATH|RUNPATH) +" "" e "${e}")
            string(STRIP "${e}" e)
            list(APPEND rpaths "${e}")
        endforeach()
        message("  ${name}: RPATH [${rpaths}]")
        if(isRuntime)
            if(NOT rpaths STREQUAL "" AND NOT rpaths STREQUAL "$ORIGIN")
                fail("${name}: RPATH [${rpaths}], expected none or $ORIGIN")
            endif()
        elseif(NOT rpaths STREQUAL "$ORIGIN")
            fail("${name}: RPATH [${rpaths}], expected $ORIGIN alone")
        endif()
    elseif(PLATFORM STREQUAL "Darwin")
        tool_output(cmds otool -l "${file}")
        string(REGEX MATCHALL "cmd LC_RPATH\n[^\n]*\n *path [^\n]*" entries "${cmds}")
        set(rpaths "")
        foreach(e IN LISTS entries)
            string(REGEX REPLACE ".*\n *path (.*) \\(offset [0-9]+\\)$" "\\1" e "${e}")
            list(APPEND rpaths "${e}")
        endforeach()
        tool_output(deps otool -L "${file}")
        string(REPLACE "\n" ";" deps "${deps}")
        list(REMOVE_AT deps 0)   # (the file's own name)
        set(absolute "")
        foreach(d IN LISTS deps)
            string(STRIP "${d}" d)
            string(REGEX REPLACE " \\(compatibility version.*$" "" d "${d}")
            if(d MATCHES "^/" AND NOT d MATCHES "^/(usr/lib|System)/")
                list(APPEND absolute "${d}")
            endif()
        endforeach()
        message("  ${name}: LC_RPATH [${rpaths}]")
        if(isRuntime)
            if(NOT rpaths STREQUAL "" AND NOT rpaths STREQUAL "@loader_path")
                fail("${name}: LC_RPATH [${rpaths}], expected none or @loader_path")
            endif()
        elseif(NOT rpaths STREQUAL "@loader_path")
            fail("${name}: LC_RPATH [${rpaths}], expected @loader_path alone")
        endif()
        if(NOT absolute STREQUAL "")
            fail("${name} loads [${absolute}] by an absolute path (not the system's)")
        endif()
    endif()

    if(isRuntime)
        file(READ "${file}" magic LIMIT 4 HEX)
        if(NOT magic MATCHES "^(7f454c46|cffaedfe|cefaedfe|cafebabe|feedfacf|feedface)$")
            fail("${name} is not an ELF or Mach-O binary (first bytes ${magic}): a linker script?")
        endif()
    endif()

    if(STRIPPED AND (PLATFORM STREQUAL "Linux" OR PLATFORM STREQUAL "Windows"))
        tool_output(sections "${OBJDUMP}" -h "${file}")
        if(sections MATCHES "\\.debug_|\\.zdebug_")
            fail("${name} has debug information (not stripped)")
        endif()
        if(PLATFORM STREQUAL "Linux")
            tool_output(syms "${OBJDUMP}" -t "${file}")
            if(NOT syms MATCHES "no symbols")
                fail("${name} has a static symbol table (not stripped)")
            endif()
        endif()
    endif()
endforeach()

if(gFailed)
    message(FATAL_ERROR "release folder: FAILED")
endif()
message("release folder: PASSED")
